{
  // The online match server (see worker.ts). Deploy with: npm run server:deploy
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "specimen-match",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "MatchRoom" }]
  },
  // The free plan only offers Durable Objects with SQLite storage.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MatchRoom"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://castillotech.github.io"
  },
  "observability": { "enabled": true }
}
